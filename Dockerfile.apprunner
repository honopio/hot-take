# Build Angular frontend (needs dev deps for Angular CLI / typescript)
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build -- --output-path=./dist

# Build backend (compile TS; needs dev deps)
FROM node:20-alpine AS backend-builder
WORKDIR /app/backend
COPY backend/package*.json ./
# install all deps (dev deps are required to build)
RUN npm ci
COPY backend/ ./
# Copy built frontend
COPY --from=frontend-build /app/dist/frontend/browser ./public
# compile typescript to dist
RUN npm run build

# 3) final runtime (only production deps + compiled output)
FROM node:20-alpine AS runtime
WORKDIR /app
# copy only package files and install production deps
COPY backend/package*.json ./
RUN npm ci --omit=dev
# copy compiled backend + static frontend
COPY --from=backend-builder /app/backend/dist ./dist
COPY --from=backend-builder /app/backend/public ./public
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "dist/server.js"]